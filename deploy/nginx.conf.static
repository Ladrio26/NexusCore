# Config nginx : servir le build statique (frontend/dist). Aucun hot reload, pas de refresh en boucle.
# Vhost HTTPS complet (recommandé) : voir nginx/nexuscore.goodloss.conf à la racine du projet.
# Sinon, à fusionner / copier vers /etc/nginx/sites-enabled/nexuscore.goodloss.conf puis : nginx -t && systemctl reload nginx
# Pour le hot reload à la place, utiliser deploy/nginx.conf.hot-reload
#
# --- HTTPS / HTTP/2 (souvent ailleurs sur le serveur : certbot, autre fichier) ---
# Ce fichier ne contient souvent pas les lignes "listen 443 ssl …" : elles sont
# ajoutées par le déploiement ou Let's Encrypt.
# Si Chrome affiche ERR_HTTP2_PROTOCOL_ERROR sur /assets/index-*.js :
#   • dans le bloc server HTTPS, remplacer  listen 443 ssl http2;  par  listen 443 ssl;
#     (sans "http2" → HTTP/1.1 sur TLS, souvent corrige l’erreur)
#   • détail : deploy/TROUBLESHOOTING_HTTP2_QUIC.md
# Exemple de lignes à avoir dans le même server { } que ci-dessous (certificats à adapter) :
#   listen 443 ssl;
#   listen [::]:443 ssl;
#   ssl_certificate     /etc/letsencrypt/live/nexuscore.goodloss.fr/fullchain.pem;
#   ssl_certificate_key /etc/letsencrypt/live/nexuscore.goodloss.fr/privkey.pem;

#########################################
#  NE PAS TOUCHER AUX LIGNES EN DESSOUS #
#########################################

server {
    server_name nexuscore.goodloss.fr;
    root /root/web/src/nexuscore.goodloss.fr/frontend/dist;

#########################################
#  NE PAS TOUCHER AUX LIGNES EN DESSUS  #
#########################################

    index index.html index.php;

    # API → backend local
    location /api/ {
        proxy_pass http://127.0.0.1:3205/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        default_type application/json;
        proxy_intercept_errors on;
        error_page 502 503 504 = @api_fallback;
    }
    location @api_fallback {
        default_type application/json;
        return 503 '{"error":"BACKEND_UNREACHABLE","message":"Service temporairement indisponible. Réessayez dans un instant."}';
    }

    # Images personnages (dossier à la racine du projet, pas dans dist)
    location /personnages/ {
        alias /root/web/src/nexuscore.goodloss.fr/personnages/;
    }

    # Fichiers statiques + SPA fallback (pas de proxy Vite = pas de HMR, pas de boucle de refresh)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Exécution des fichiers PHP normaux
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.4-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_index index.php;
    }

#########################################
#  NE PAS TOUCHER AUX LIGNES EN DESSOUS #
#########################################

    access_log /mnt/hdd/web/logs/nexuscore_access.log;
    error_log /mnt/hdd/web/logs/nexuscore_error.log;

}

#########################################
#  NE PAS TOUCHER AUX LIGNES EN DESSUS  #
#########################################
